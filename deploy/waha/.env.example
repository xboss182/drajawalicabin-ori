# WAHA + booking-bridge environment. Copy to /opt/waha/.env, fill values, chmod 600.
# NEVER commit the filled .env — this example carries names only, no literals.

# WAHA API key. WAHA reads it directly; the bridge needs the plaintext to call the
# API. Generate: head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
WAHA_API_KEY=

# HMAC key WAHA uses to sign outbound webhooks; the bridge verifies the
# x-webhook-hmac header against this same value. Generate as above.
WAHA_WEBHOOK_HMAC_KEY=

# Bridge -> Lovable Cloud machine API shared secret (HMAC). Server-side only.
WA_MACHINE_SECRET=

# Lovable Cloud machine API base URL (source of truth).
MACHINE_URL=https://drajawalicabin.com

# Optional overrides (defaults shown):
# WAHA_URL=http://waha:3000
# WAHA_SESSION=default
# BRIDGE_PORT=8080
# WA_MACHINE_KEY_ID=wa-bridge-v1
